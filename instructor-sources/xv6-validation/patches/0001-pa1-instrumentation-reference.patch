diff --git a/spin.c b/spin.c
new file mode 100644
index 0000000..ff082d9
--- /dev/null
+++ b/spin.c
@@ -0,0 +1,20 @@
+#include "types.h"
+#include "user.h"
+
+int
+main(int argc, char *argv[])
+{
+  int i;
+  volatile int x = 0;
+
+  if(argc != 2){
+    printf(2, "usage: spin positive-iterations\n");
+    exit();
+  }
+
+  for(i = 1; i < atoi(argv[1]); i++)
+    x++;
+
+  printf(1, "pid(%d): x = %d\n", getpid(), x);
+  exit();
+}

