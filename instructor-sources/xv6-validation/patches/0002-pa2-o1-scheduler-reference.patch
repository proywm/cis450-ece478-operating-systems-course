@@ -19,6 +34,58 @@ extern void forkret(void);
 extern void trapret(void);
 
 static void wakeup1(void *chan);
+static void enqueueproc(struct proc *p, int athead);
+
+// Run-queue helpers. Every caller holds ptable.lock.
+static void
+queueput(struct runqueue *q, struct proc *p, int athead)
+{
+  uint slot;
+
+  if(p->onrunq)
+    panic("queueput duplicate");
+  if(q->count == NPROC)
+    panic("queueput full");
+  if(athead){
+    q->head = (q->head + NPROC - 1) % NPROC;
+    slot = q->head;
+  } else {
+    slot = (q->head + q->count) % NPROC;
+  }
+  q->items[slot] = p;
+  q->count++;
+  p->onrunq = 1;
+}
+
+static struct proc*
+queueget(struct runqueue *q)
+{
+  struct proc *p;
+
+  while(q->count){
+    p = q->items[q->head];
+    q->items[q->head] = 0;
+    q->head = (q->head + 1) % NPROC;
+    q->count--;
+    p->onrunq = 0;
+    if(p->state == RUNNABLE)
+      return p;
+  }
+  return 0;
+}
+
+static void
+enqueueproc(struct proc *p, int athead)
+{
+  if(p->state != RUNNABLE)
+    panic("enqueueproc state");
+  if(p->queuetype == QUEUE_FIRST)
+    queueput(&firstq, p, athead);
+  else if(p->queuetype == QUEUE_EXPIRED)
+    queueput(expiredq, p, athead);
+  else
+    queueput(activeq, p, athead);
+}
 
