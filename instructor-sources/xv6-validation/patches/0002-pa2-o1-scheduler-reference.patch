+
+struct runqueue {
+  struct proc *items[NPROC];
+  uint head;
+  uint count;
+};
+
+static struct runqueue firstq;
+static struct runqueue active_store;
+static struct runqueue expired_store;
+static struct runqueue *activeq = &active_store;
+static struct runqueue *expiredq = &expired_store;
+
 static struct proc *initproc;
 
