+
+// Charge one 10 ms timer tick to the running process. Called immediately
+// before the timer path yields the CPU.
+void
+scheduler_tick(void)
+{
+  struct proc *p = myproc();
+  char *queue;
 
+  if(p == 0)
+    return;
+  acquire(&ptable.lock);
+  if(p->state == RUNNING){
+    queue = p->queuetype == QUEUE_FIRST ? "FQ" : "AQ";
+    if(strncmp(p->name, "spin", sizeof(p->name)) == 0)
+      cprintf("Process spin %d has consumed 10 ms in %s\n", p->pid, queue);
+    if(p->quantumsize > 0)
+      p->quantumsize--;
+    if(p->quantumsize == 0){
+      if(p->queuetype == QUEUE_FIRST)
+        p->queuetype = QUEUE_ACTIVE;
+      else
+        p->queuetype = QUEUE_EXPIRED;
+      p->quantumsize = ACTIVE_TICKS;
+      p->resumehead = 0;
+    } else {
+      p->resumehead = 1;
+    }
   }
+  release(&ptable.lock);
 }
 
