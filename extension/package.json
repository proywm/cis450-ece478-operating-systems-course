{
  "name": "systemstudio-cis450-ece478",
  "displayName": "SystemStudio CIS 450 / ECE 478",
  "description": "Accessible Fall 2026 Operating Systems learning hub with OSTEP-aligned modules, hands-on labs, local progress, and academic-integrity support.",
  "version": "0.2.0",
  "private": true,
  "publisher": "probir-roy",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Education", "Other"],
  "activationEvents": [
    "onView:systemstudioOs.course",
    "onCommand:systemstudioOs.openLearningHub",
    "onCommand:systemstudioOs.openCanvas",
    "onCommand:systemstudioOs.openSyllabus",
    "onCommand:systemstudioOs.openAccessibleLessons",
    "onCommand:systemstudioOs.createLabWorkspace",
    "onCommand:systemstudioOs.checkEnvironment",
    "onCommand:systemstudioOs.runCurrentC",
    "onCommand:systemstudioOs.exportCalendar",
    "onCommand:systemstudioOs.configureCanvas",
    "onCommand:systemstudioOs.importCanvasCalendar",
    "onCommand:systemstudioOs.createModuleLab",
    "onCommand:systemstudioOs.validateEvidence"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "systemstudioOs.openLearningHub", "title": "CIS 450 / ECE 478: Open Learning Hub", "icon": "$(book)" },
      { "command": "systemstudioOs.openCanvas", "title": "CIS 450 / ECE 478: Open Canvas", "icon": "$(cloud)" },
      { "command": "systemstudioOs.openSyllabus", "title": "CIS 450 / ECE 478: Open Fall 2026 Syllabus", "icon": "$(file-pdf)" },
      { "command": "systemstudioOs.openAccessibleLessons", "title": "CIS 450 / ECE 478: Open Accessible Lesson Collection", "icon": "$(book)" },
      { "command": "systemstudioOs.createLabWorkspace", "title": "CIS 450 / ECE 478: Create Portable OS Lab Workspace", "icon": "$(new-folder)" },
      { "command": "systemstudioOs.checkEnvironment", "title": "CIS 450 / ECE 478: Check Docker and C Toolchain", "icon": "$(tools)" },
      { "command": "systemstudioOs.runCurrentC", "title": "CIS 450 / ECE 478: Build and Run Current C File", "icon": "$(run)" },
      { "command": "systemstudioOs.exportCalendar", "title": "CIS 450 / ECE 478: Export Fall 2026 Calendar", "icon": "$(calendar)" },
      { "command": "systemstudioOs.configureCanvas", "title": "CIS 450 / ECE 478: Configure Canvas Links", "icon": "$(settings-gear)" },
      { "command": "systemstudioOs.importCanvasCalendar", "title": "CIS 450 / ECE 478: Import Canvas Calendar (.ics)", "icon": "$(calendar)" },
      { "command": "systemstudioOs.createModuleLab", "title": "CIS 450 / ECE 478: Create Guided Module Lab", "icon": "$(beaker)" },
      { "command": "systemstudioOs.validateEvidence", "title": "CIS 450 / ECE 478: Validate Coursework Evidence Files", "icon": "$(verified)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "systemstudioOs", "title": "CIS 450 / ECE 478", "icon": "media/os.svg" }
      ]
    },
    "views": {
      "systemstudioOs": [
        { "id": "systemstudioOs.course", "name": "Operating Systems Course" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "systemstudioOs.course",
        "contents": "Open the active Fall 2026 course hub.\n[Open Learning Hub](command:systemstudioOs.openLearningHub)"
      }
    ],
    "configuration": {
      "title": "SystemStudio CIS 450 / ECE 478",
      "properties": {
        "systemstudioOs.canvasCourseUrl": {
          "type": "string",
          "default": "",
          "description": "Direct Fall 2026 UM-Dearborn Canvas course URL. Leave blank until the course URL is verified."
        },
        "systemstudioOs.canvasDiscussionUrl": {
          "type": "string",
          "default": "",
          "description": "Optional verified Canvas discussion URL for pre-class questions. The extension only copies a draft and opens this page."
        },
        "systemstudioOs.canvasPrivateMessageUrl": {
          "type": "string",
          "default": "",
          "description": "Optional verified Canvas Inbox or course-contact URL for private pre-class questions."
        }
      }
    }
  },
  "scripts": {
    "export:lessons": "tsx scripts/exportAccessible.ts",
    "stage:course-pack": "node scripts/stageCoursePack.mjs",
    "compile": "node esbuild.mjs",
    "test:webview": "node scripts/checkWebviewSyntax.mjs",
    "test:starters": "tsx scripts/smokeLabs.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run export:lessons && npm run stage:course-pack && npm run typecheck && npm test && npm run test:starters && npm run compile && npm run test:webview",
    "package": "npm run check && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
